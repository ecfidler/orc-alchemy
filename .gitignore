#.env

# Log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage results
coverage/
.nyc_output/

# IDEs and Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# System Files
.DS_Store
Thumbs.db

# Local markdown files

*.local.md

# Playwright output
test-results/
playwright-report/

# The owner's private .orcbrew export. Never commit it (fixtures/orcbrew/private/ tests skip without it).
fixtures/orcbrew/private/*.orcbrew
