{
  "name": "orc-alchemy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.0.14",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "docs:check": "bun scripts/okf-check.ts docs",
    "test:scripts": "bun test scripts/",
    "budgets": "bun scripts/budgets.ts",
